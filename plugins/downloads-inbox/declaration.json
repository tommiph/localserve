    {
      "id": "theme-lcars",
      "name": "LCARS display",
      "directory": "cards/theme-lcars",
      "entry": "card.html",
      "assets": [
        "card.html",
        "card.css"
      ],
      "slots": [
        {
          "id": "hero",
          "field": "received-count",
          "format": "number",
          "decimals": 0
        },
        {
          "id": "metric-1",
          "field": "last-file"
        },
        {
          "id": "metric-2",
          "field": "torrent-count",
          "format": "number",
          "decimals": 0
        },
        {
          "id": "metric-3",
          "field": "last-transfer-at",
