    {
      "id": "lookup-channel",
      "name": "Find channel",
      "settingsOnly": true,
      "description": "Find up to five public channel matches by name, @handle, channel ID or supported URL. Select a result to add it in Settings.",
      "parameters": [
        {
          "id": "query",
          "label": "Channel name, @handle, ID or URL",
          "type": "string",
          "required": true,
          "maxLength": 200
        }
      ]
    }
