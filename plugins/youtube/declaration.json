    ]
  },
  "settingsGuide": {
    "title": "YouTube setup and testing",
    "sections": [
      {
        "title": "Connect a channel",
        "steps": [
          "Enter a Google API key with YouTube Data API v3 enabled. Settings save when changed; browser-referrer key restrictions may reject server requests.",
          "Enable YouTube and the server, and turn Pause API calls off. In Channels, choose Find channel, search, then select Use channel. Review the entry, enable it and save. Search results start disabled.",
          "Open Events and select the Channel under Current readings. The first successful refresh lists current videos and establishes a baseline; it does not emit Video released for existing uploads. Refresh videos respects the next allowed check."
        ]
      },
      {
        "title": "Play a new upload on the TV",
        "steps": [
          "YouTube monitors uploads. Samsung TV performs playback: configure and enable Samsung TV, then enable YouTube playback in its Settings. This sends the TV’s private screen ID to YouTube for a temporary session; no Google account or Data API key is used for playback.",
          "In Tasks, add a Task with Add rule → Event and choose your Channel’s Video released event. Videos updated reports refreshes and counts; it has no released video title or ID.",
          "Add Samsung TV → Play YouTube video. In the Video ID event-value selector, choose Video ID to insert {{event.video-id}}. Keep the default app ID unless your TV requires another installed YouTube app.",
          "Enable the Task and Event rule, then save. Future uploads detected while monitoring is active can start it. The TV must already be on and reachable; playback does not wake it. Missed uploads are not replayed automatically."
        ]
      },
      {
        "title": "Test a notice, delay and playback",
        "steps": [
          "Before a new upload arrives, test playback using an existing eleven-character Video ID entered directly in the action, then save and choose Run. Current readings do not create a saved Video released Event.",
          "For an Event-based Task, add Show TV notice with Video title as its Title and insert other declared Event values into Message. Add Delay set to 10 seconds, then Play YouTube video using Video ID. Choose a 10-second notice duration for this example.",
          "Run can select retained Event values from matching Task history. Rerun on a finished run starts the current Task from step one with that run’s captured values. Keep the Task enabled; its automatic Event rule can be disabled during manual testing.",
          "If no matching history exists, allow a real Event to start a Task first, or use literal text and a literal Video ID for the initial test. No Event values are invented. Optional properties may be absent; binding a missing value stops all steps before effects."
        ]
      },
      {
        "title": "If nothing happens",
        "steps": [
          "Check server Enabled, plugin Enabled, Channel Enabled and Pause API calls. In Events → Current readings, inspect API calls, Last request error, Next allowed check and Successful reception. Provider errors and quota limits can postpone checks; Refresh videos does not bypass them.",
          "For automatic playback, check Task Enabled, Event rule Enabled, the selected Channel and any condition. The first refresh, a changed Channel and resuming after missed uploads do not release old videos.",
          "For playback failures, check Samsung TV configuration, YouTube playback, its explicit YouTube control port (default 8080), and Task runs or Activity for the error. A successful command does not confirm what played; verify the TV screen."
        ]
      }
    ]
  },
  "settings": [
    {
      "id": "api-key",
      "label": "YouTube Data API key",
      "type": "string",
      "format": "secret",
      "default": "",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]{0,200}$",
      "help": "Use a Google API key with YouTube Data API v3 enabled. Stored in private plugin settings, masked here and never available to Cards. Server/IP restrictions work; browser-referrer restrictions may reject server requests."
    },
    {
      "id": "api-paused",
      "label": "Pause API calls",
      "type": "boolean",
      "required": true,
      "default": false,
      "help": "Stops upload checks and channel lookup without deleting the key or readings. Resuming does not replay uploads missed while paused."
    },
    {
      "id": "poll-minutes",
      "label": "Polling interval",
      "type": "number",
      "required": true,
      "default": 15,
      "min": 15,
      "max": 240,
      "enum": [
        15,
        30,
        60,
        120,
        240
      ],
      "enumLabels": [
        "15 minutes",
        "30 minutes",
        "1 hour",
        "2 hours",
        "4 hours"
      ],
      "help": "Minimum interval per enabled Channel, with staggered serial requests. Many Channels may slow checks to target 1,500 daily read units. Current values shows effective cadence and local estimated budgets."
    },
    {
      "id": "channels",
      "label": "Channels",
      "type": "list",
      "itemLabel": "channel",
      "maxItems": 20,
      "default": [],
      "uniqueBy": [
        "id",
        "name",
        "query"
      ],
      "fields": [
        {
          "id": "id",
          "label": "Channel source ID",
          "type": "string",
          "required": true,
          "format": "identifier",
          "maxLength": 64
        },
        {
          "id": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "maxLength": 32
        },
        {
          "id": "query",
          "label": "Channel ID, @handle or URL",
          "type": "string",
          "required": true,
          "maxLength": 200,
          "help": "Enter an @handle, UC channel ID or supported HTTPS YouTube channel URL. Find channel in Settings lets you search by name and choose a result."
        },
        {
          "id": "enabled",
          "label": "Enabled",
          "type": "boolean",
          "required": true
        }
      ],
      "help": "Each named Channel has separate Cards and Task events. Copies start disabled. New/changed Channels baseline current public uploads without releasing old events."
    }
  ],
