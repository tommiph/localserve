          "id": "search-id",
          "label": "Search",
          "type": "string",
          "default": "",
          "maxLength": 64
        }
      ]
    }
  ],
  "events": [
    {
      "id": "news-updated",
      "name": "News updated",
      "description": "A news feed was fetched and saved successfully, including an empty result.",
      "testAction": "refresh",
      "payload": [
        {
          "id": "search-id",
          "label": "Search ID",
          "type": "string",
          "required": true,
          "maxLength": 64
        },
        {
          "id": "search-name",
