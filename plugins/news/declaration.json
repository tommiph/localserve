{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "news",
  "name": "News",
  "version": "1.2.1",
  "description": "Headlines from Google News RSS",
  "icon": "newspaper",
  "runtime": {
    "entry": "server/index.mjs",
    "stateMaxBytes": 1048576
  },
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes",
    "targetParameter": "search-id"
  },
  "instances": {
    "setting": "searches",
    "stateKey": "searches",
    "eventKey": "search-id",
    "queryUrlMigration": {
      "baseUrl": "https://news.google.com/rss/search",
      "queryParameter": "q",
      "parameters": [
        {
          "setting": "language",
          "parameter": "hl",
          "default": "fi-FI"
        },
        {
          "setting": "country",
          "parameter": "gl",
          "default": "FI"
        },
        {
          "setting": "edition",
          "parameter": "ceid",
          "default": "FI:fi"
        }
      ]
    }
  },
  "settings": [
    {
      "id": "poll-minutes",
      "label": "Polling interval",
      "type": "number",
      "default": 60,
      "min": 15,
      "max": 60,
      "enum": [
        15,
        30,
        45,
        60
      ],
      "enumLabels": [
        "15 minutes",
        "30 minutes",
        "45 minutes",
        "1 hour"
      ],
      "help": "Applies to each enabled search. Requests are staggered across the interval."
    },
    {
      "id": "searches",
      "label": "Searches",
      "type": "list",
      "itemLabel": "search",
      "maxItems": 20,
      "default": [],
      "uniqueBy": [
        "id",
        "name",
        "query"
      ],
      "help": "Add named locations or topics for separate headlines, card fields, and Task events.",
      "fields": [
        {
          "id": "id",
          "label": "Search ID",
          "type": "string",
          "required": true,
          "format": "identifier",
          "maxLength": 64
        },
        {
          "id": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "maxLength": 32
        },
        {
          "id": "query",
          "label": "Feed URL",
          "type": "string",
          "required": true,
          "default": "https://news.google.com/rss/search?q=Kerava&hl=fi-FI&gl=FI&ceid=FI:fi",
          "maxLength": 2000,
          "pattern": "^https://news\\.google\\.com/rss(?:[/?][^\\u0000-\\u001f\\u007f]*)?$",
          "help": "Paste the whole Google News RSS Feed URL, including all query parameters. Use the complete URL generated for your specific Google News search, topic, language, or edition. Example: https://news.google.com/rss/search?q=Kerava&hl=fi-FI&gl=FI&ceid=FI:fi"
        },
        {
          "id": "enabled",
          "label": "Enabled",
          "type": "boolean",
          "required": true
        }
      ]
    }
  ],
  "cardFields": [
    {
      "id": "articles",
      "label": "Articles",
      "type": "table",
      "icon": "newspaper",
      "columns": [
        {
          "id": "title",
          "label": "Title",
          "type": "string"
        },
        {
          "id": "date",
          "label": "Date",
          "type": "timestamp"
        }
      ],
      "source": {
        "kind": "rows",
        "countKey": "article-count",
        "sort": {
          "column": "date",
          "direction": "desc"
        },
        "rows": [
          {
            "title": "article-1-title",
            "date": "article-1-published-at"
          },
          {
            "title": "article-2-title",
