{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "finavia",
  "name": "Finavia",
  "version": "1.1.1",
  "description": "Finnish airport flight boards · Source: Finavia Public Flights",
  "icon": "flight-takeoff",
  "runtime": {
    "entry": "server/index.mjs",
    "stateMaxBytes": 1048576
  },
  "defaultCardLayout": "table",
  "attribution": {
    "label": "Finavia",
    "url": "https://apiportal.finavia.fi/",
    "licenseUrl": "https://apiportal.finavia.fi/signup",
    "licenseLabel": "API terms",
    "notice": "Filtered and formatted by Sormus"
  },
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes",
    "targetParameter": "location-id"
  },
  "instances": {
    "setting": "locations",
    "stateKey": "locations",
    "eventKey": "location-id"
  },
  "settings": [
    {
      "id": "api-key",
      "label": "API key",
      "type": "string",
      "maxLength": 128,
      "default": "",
      "format": "secret",
      "help": "Private Finavia subscription key. Sent only in the authentication header; never included in Cards or Vistas."
    },
    {
      "id": "poll-minutes",
      "label": "Polling interval",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 5,
      "enum": [
        1,
        2,
        5
      ],
      "enumLabels": [
        "1 minute",
        "2 minutes",
        "5 minutes"
      ],
      "help": "Applies per enabled location. Serial requests are staggered; provider caching and slow requests can delay events."
    },
    {
      "id": "locations",
      "label": "Locations",
      "type": "list",
      "itemLabel": "location",
      "maxItems": 20,
      "default": [],
      "uniqueBy": [
        "id",
        "name"
      ],
      "help": "Named Finnish airport boards with optional route and flight filters. Source: Finavia Public Flights.",
      "fields": [
        {
          "id": "id",
          "label": "Location ID",
          "type": "string",
          "maxLength": 64,
          "required": true,
          "format": "identifier"
        },
        {
          "id": "name",
          "label": "Name",
          "type": "string",
          "maxLength": 32,
          "required": true
        },
        {
          "id": "airport",
          "label": "Airport",
          "type": "string",
          "maxLength": 3,
          "default": "HEL",
          "required": true,
          "pattern": "^[A-Za-z]{3}$",
          "suggestions": [
            {
              "value": "HEL",
              "label": "Helsinki Airport (HEL)"
            },
            {
              "value": "IVL",
              "label": "Ivalo (IVL)"
            },
            {
              "value": "JOE",
              "label": "Joensuu (JOE)"
            },
            {
              "value": "JYV",
              "label": "Jyväskylä (JYV)"
            },
            {
              "value": "KAJ",
              "label": "Kajaani (KAJ)"
            },
            {
              "value": "KEM",
              "label": "Kemi-Tornio (KEM)"
            },
            {
              "value": "KTT",
              "label": "Kittilä (KTT)"
            },
            {
              "value": "KOK",
              "label": "Kokkola-Pietarsaari (KOK)"
            },
            {
              "value": "KAO",
              "label": "Kuusamo (KAO)"
            },
            {
              "value": "KUO",
              "label": "Kuopio (KUO)"
            },
            {
              "value": "MHQ",
              "label": "Mariehamn (MHQ)"
            },
            {
              "value": "OUL",
              "label": "Oulu (OUL)"
            },
            {
              "value": "POR",
              "label": "Pori (POR)"
            },
            {
              "value": "RVN",
              "label": "Rovaniemi (RVN)"
            },
            {
              "value": "SVL",
              "label": "Savonlinna (SVL)"
            },
            {
              "value": "TMP",
              "label": "Tampere-Pirkkala (TMP)"
            },
            {
              "value": "TKU",
              "label": "Turku (TKU)"
            },
            {
              "value": "VAA",
              "label": "Vaasa (VAA)"
            }
          ],
          "help": "Choose a Finnish airport or type its three-letter IATA code, for example HEL, OUL or RVN."
        },
        {
          "id": "direction",
          "label": "Show flights",
          "type": "string",
          "maxLength": 64,
          "required": true,
          "default": "departures",
          "enum": [
            "arrivals",
            "departures",
            "both"
          ],
          "enumLabels": [
            "Arrivals",
            "Departures",
            "Arrivals and departures"
          ]
        },
        {
          "id": "other-airport",
          "label": "Route airport",
          "type": "string",
          "maxLength": 3,
          "default": "",
          "pattern": "^(?:[A-Za-z]{3})?$",
          "help": "Optional route stop IATA code, for example LHR. Blank includes all routes. No transfer planning."
        },
        {
          "id": "flight",
          "label": "Flight number",
          "type": "string",
          "maxLength": 16,
          "default": "",
          "pattern": "^[A-Za-z0-9]{0,16}$",
          "help": "Optional exact flight or codeshare number, for example AY1331. Blank includes all flights."
        },
        {
          "id": "advance-minutes",
          "label": "Advance notice (minutes)",
          "type": "number",
          "required": true,
          "default": 2,
          "min": 0,
          "max": 30,
          "help": "Upcoming events use the current estimate, or schedule when no estimate exists. Confirmed events require a provider actual movement time."
        },
        {
          "id": "enabled",
          "label": "Enabled",
          "type": "boolean",
          "required": true
        }
      ]
    }
  ],
  "cardFields": [
    {
      "id": "flights",
      "label": "Flights",
      "type": "table",
      "icon": "plane",
      "columns": [
