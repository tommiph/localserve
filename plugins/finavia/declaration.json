        {
          "id": "time",
          "label": "Time",
          "type": "timestamp",
          "format": "time",
          "position": "last"
        },
        {
          "id": "in-minutes",
          "label": "In",
          "type": "timestamp",
          "format": "minutes-until",
          "position": "last"
        }
      ],
