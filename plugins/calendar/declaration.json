{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "calendar",
  "name": "Calendar",
  "version": "1.3.1",
  "icon": "calendar",
  "description": "Subscribed calendars, local dates, countdowns and Task reminders",
  "defaultCardLayout": "table",
  "runtime": {
    "entry": "server/index.mjs",
    "stateMaxBytes": 1048576
  },
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes",
    "targetParameter": "calendar-id"
  },
  "instances": {
    "setting": "calendars",
    "stateKey": "calendars",
    "eventKey": "calendar-id"
  },
  "settings": [
    {
      "id": "poll-minutes",
      "label": "Reminder check interval",
      "type": "number",
      "required": true,
      "default": 1,
      "min": 1,
      "max": 5,
      "enum": [
        1,
        2,
        5
      ],
      "enumLabels": [
        "1 minute",
        "2 minutes",
        "5 minutes"
      ],
      "help": "Checks the cached agenda. Task reminders run on the next check after their due time."
    },
    {
      "id": "feed-minutes",
      "label": "Feed refresh interval",
      "type": "number",
      "required": true,
      "default": 15,
      "min": 5,
      "max": 60,
      "enum": [
        5,
        15,
        30,
        60
      ],
      "enumLabels": [
        "5 minutes",
        "15 minutes",
        "30 minutes",
        "1 hour"
      ],
      "help": "Per enabled calendar. Feed failures pause reminders until a successful refresh."
    },
    {
      "id": "calendars",
      "label": "Calendars and dates",
      "type": "list",
      "itemLabel": "calendar",
      "maxItems": 20,
      "default": [],
      "uniqueBy": [
        "id",
        "name"
      ],
      "help": "Choose a read-only subscription or a local date/countdown. Local dates need no subscription or account. All local times use the server’s system timezone.",
      "fields": [
        {
          "id": "id",
          "label": "Calendar ID",
          "type": "string",
          "required": true,
          "format": "identifier",
          "maxLength": 64
        },
        {
          "id": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "maxLength": 32
        },
        {
          "id": "source-type",
          "label": "Source",
          "type": "string",
          "default": "subscription",
          "enum": [
            "subscription",
            "date"
          ],
          "enumLabels": [
            "Calendar subscription",
            "Local date / countdown"
          ]
        },
        {
          "id": "url",
          "label": "Subscription URL",
          "type": "string",
          "format": "secret",
          "maxLength": 2000,
          "help": "Complete public HTTPS feed address. webcal links use HTTPS. No sign-in, redirects, attachments or linked pages are opened."
        },
        {
          "id": "target-date",
          "label": "Target date",
          "type": "string",
          "format": "date",
          "maxLength": 10,
          "default": "",
          "help": "Server local date, 1970–9999. A missing daylight-saving minute is rejected."
        },
        {
          "id": "target-time",
          "label": "Target time",
          "type": "string",
          "format": "time",
          "maxLength": 5,
          "default": "",
          "help": "Server local time, to the minute. Date reached emits on the next active check; missed checks do not replay."
        },
        {
          "id": "reminder-minutes",
          "label": "Reminder before event (minutes)",
          "type": "number",
          "required": true,
          "default": 10,
          "min": 0,
          "max": 1440,
          "help": "Whole minutes before the start; 0 disables upcoming reminders. Event started and ended remain available to Tasks."
        },
        {
          "id": "enabled",
          "label": "Enabled",
          "type": "boolean",
          "required": true
        }
      ]
    }
  ],
  "cardFields": [
    {
      "id": "event-count",
      "label": "Upcoming cached events",
      "type": "number",
      "icon": "calendar",
      "source": {
