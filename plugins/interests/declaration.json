  ],
  "events": [
    {
      "id": "item-discovered",
      "name": "New item",
      "occurrenceKey": "discovery-id",
      "description": "A new, dated item discovered after a successful baseline. Claims persist before Tasks; cached refreshes and mixed digests do not duplicate Events.",
      "payload": [
        {
          "id": "topic-id",
          "label": "Interest ID",
          "type": "string",
          "required": true,
          "maxLength": 64
