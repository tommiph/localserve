{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "movies",
  "name": "Movies",
  "version": "1.3.0",
  "icon": "movie-filter",
  "description": "Daily movie suggestions, a watchlist and optional live movie discovery",
  "defaultCardLayout": "table",
  "runtime": {
    "entry": "server/index.mjs",
    "stateMaxBytes": 1048576
  },
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes"
  },
  "settings": [
    {
      "id": "poll-minutes",
      "label": "Guide check interval",
      "type": "number",
      "required": true,
      "default": 15,
      "enum": [
        15,
        30,
        60,
        120
      ],
      "enumLabels": [
        "15 minutes",
        "30 minutes",
        "1 hour",
        "2 hours"
      ],
      "min": 15,
      "max": 120,
      "help": "Updates the daily selection from cached metadata. Starter picks make no network requests."
    },
    {
      "id": "refresh-hours",
      "label": "Live metadata refresh",
      "type": "number",
      "required": true,
      "default": 6,
      "enum": [
        6,
        12,
        24
      ],
      "enumLabels": [
        "6 hours",
        "12 hours",
        "24 hours"
      ],
      "min": 6,
      "max": 24
    },
    {
      "id": "source",
      "label": "Suggestion source",
      "type": "string",
      "required": true,
      "default": "starter",
      "enum": [
        "starter",
        "discover",
        "popular",
        "upcoming"
      ],
      "enumLabels": [
        "Starter collection · no account needed",
        "TMDB · Discover released movies",
        "TMDB · Popular movies",
        "TMDB · Upcoming cinema releases"
      ]
    },
    {
      "id": "genre",
      "label": "Preferred genre",
      "type": "string",
      "required": false,
      "default": "",
      "enum": [
        "",
        "Science-Fiction",
        "Drama",
        "Comedy",
        "Thriller",
        "Fantasy",
        "Action",
        "Mystery",
        "Adventure",
        "Animation",
        "Crime",
        "Documentary",
        "Family",
        "History",
        "Horror",
        "Romance"
      ],
      "enumLabels": [
        "All genres",
        "Science-Fiction",
        "Drama",
        "Comedy",
        "Thriller",
        "Fantasy",
        "Action",
        "Mystery",
        "Adventure",
        "Animation",
        "Crime",
        "Documentary",
        "Family",
        "History",
        "Horror",
        "Romance"
      ]
    },
    {
      "id": "genres",
      "label": "Preferred genres",
      "type": "string",
      "maxLength": 250,
      "pattern": "^(?:(?:Science-Fiction|Drama|Comedy|Thriller|Fantasy|Action|Mystery|Adventure|Animation|Crime|Documentary|Family|History|Horror|Romance)(?:,(?!$)|$))*$",
      "help": "Select any genres for daily suggestions. An empty selection includes all genres."
    },
    {
      "id": "hide-watched",
      "label": "Hide watched movies from daily picks",
      "type": "boolean",
      "required": true,
      "default": true
    },
    {
      "id": "api-token",
      "label": "TMDB API read access token",
      "type": "string",
      "default": "",
      "format": "secret",
      "maxLength": 2000,
      "section": "Optional live movie information",
      "help": "Not needed for the starter collection. Add your own TMDB API read access token to use live discovery, releases and full-catalogue search. It is sent only to TMDB in an authorization header."
    },
    {
      "id": "region",
      "label": "Release country",
      "type": "string",
      "default": "FI",
      "required": true,
      "maxLength": 2,
      "pattern": "^[A-Z]{2}$",
      "section": "Optional live movie information",
      "help": "Country code, for example FI, US or GB. Release information does not confirm availability on your streaming subscriptions."
    },
    {
      "id": "language",
      "label": "Information language",
      "type": "string",
      "default": "en-US",
      "required": true,
      "maxLength": 5,
      "pattern": "^[a-z]{2}-[A-Z]{2}$",
      "section": "Optional live movie information"
    }
  ],
  "settingsGuide": {
    "title": "Movies setup",
    "sections": [
      {
        "title": "Start watching",
        "steps": [
          "Enable Movies. The starter collection provides four day-by-day suggestions without an account or key. Choose a genre in Settings.",
          "Save adds a movie to Watchlist. Watched moves it to history; the default setting hides watched movies from daily suggestions. Mark unwatched to return it to Watchlist.",
          "Create a Daily movie suggestions Card, or its Fullscreen design, in Card designer. Add it to a Vista or Card collection. Suggestions are not playback commands."
        ]
      },
      {
        "title": "Optional live discovery",
        "steps": [
          "In TMDB account Settings > API, obtain your own API Read Access Token. Paste it into Movies Settings, select a TMDB source, choose the country and language, then save. Do not share the token.",
          "Discover released movies uses genre and popularity filters; Popular follows TMDB popularity; Upcoming contains future cinema releases. A release or network name is not confirmation that your subscription includes it.",
          "Without a token, search covers the starter collection. With a token, explicit searches use the TMDB movie catalogue. Metadata refresh is bounded and cached; no article pages, posters, login cookies or streaming accounts are fetched.",
          "TMDB data requires attribution. This product uses the TMDB API but is not endorsed or certified by TMDB. Noncommercial API use is free with attribution; commercial use requires agreement with TMDB."
        ]
      }
    ]
  },
