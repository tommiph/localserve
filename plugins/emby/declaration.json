{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "emby",
  "name": "Emby",
  "version": "1.1.0",
  "description": "Reported playback sessions from your Emby server",
  "icon": "movie",
  "defaultCardLayout": "table",
  "runtime": {
    "entry": "server/index.mjs",
    "stateMaxBytes": 1048576
  },
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes"
  },
  "settings": [
    {
      "id": "server-url",
      "label": "Server URL",
      "type": "string",
      "default": "",
      "maxLength": 200,
      "help": "Private IPv4 or loopback address with explicit port, for example http://192.168.0.10:8096. HTTPS requires a trusted certificate. No discovery or redirects."
    },
    {
      "id": "api-key",
      "label": "API key",
      "type": "string",
      "format": "secret",
      "default": "",
      "maxLength": 256,
      "pattern": "^(?:[A-Za-z0-9_-]{16,256})?$",
      "help": "Paste only the dedicated API key value from the Emby dashboard, without its application name, label or spaces. Used only for read-only session requests; never sent to Cards or Tasks."
    },
    {
      "id": "poll-minutes",
      "label": "Polling interval",
      "type": "number",
      "required": true,
      "default": 0.5,
      "min": 0.16666666666666666,
      "max": 1,
      "enum": [
        0.16666666666666666,
        0.5,
        1
      ],
      "enumLabels": [
        "10 seconds",
        "30 seconds",
        "1 minute"
      ],
      "help": "Reads reported sessions serially. Playback events are observed changes; no playback commands are sent."
    }
  ],
  "cardFields": [
    {
      "id": "session-count",
      "label": "Reported sessions",
      "type": "number",
      "icon": "play",
      "source": {
        "kind": "state",
