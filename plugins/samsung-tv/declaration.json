    {
      "id": "volume",
      "name": "Set volume",
      "parameters": [
        {
          "id": "value",
          "label": "Volume (%)",
          "type": "number",
          "required": true,
          "default": 20,
          "min": 0,
          "max": 100
        }
      ],
      "description": "Send one explicit TV operation without retry. Supported behavior depends on this TV’s firmware."
    },
    {
      "id": "mute",
      "name": "Set mute",
      "parameters": [
        {
          "id": "muted",
          "label": "Muted",
          "type": "boolean",
          "required": true,
          "default": true
        }
      ],
      "description": "Send one explicit TV operation without retry. Supported behavior depends on this TV’s firmware."
    },
    {
      "id": "input",
      "name": "Select input",
      "parameters": [
        {
          "id": "input",
          "label": "Input",
          "type": "string",
          "required": true,
          "default": "TV",
          "enum": [
            "TV",
            "HDMI1",
            "HDMI2",
            "HDMI3",
            "HDMI4"
          ]
        }
      ],
      "description": "Send one explicit TV operation without retry. Supported behavior depends on this TV’s firmware."
    },
    {
      "id": "show-notice",
      "name": "Show TV notice",
      "description": "Show Notice, Alarm, Alert or Warning with optional automatic close and looping sound. Untimed notices show elapsed time until dismissed. One notice at a time; delivery does not confirm display/audio.",
      "parameters": [
        {
          "id": "template",
          "label": "Template",
          "type": "string",
          "default": "Notice",
          "enum": [
            "Notice",
            "Alarm",
            "Alert",
            "Warning"
          ]
        },
        {
          "id": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "maxLength": 120
        },
        {
          "id": "message",
          "label": "Message",
          "type": "string",
          "format": "multiline",
          "required": true,
          "maxLength": 2000
        },
        {
          "id": "auto-close",
          "label": "Close automatically",
          "type": "boolean",
          "default": true,
          "help": "Turn off to keep the notice open until dismissed. The screen shows elapsed time. Back or Tasks → Dismiss notice closes it."
        },
        {
          "id": "seconds",
          "label": "Display time (seconds)",
          "type": "number",
          "min": 1,
          "max": 3600,
          "default": 10
        },
        {
          "id": "sound",
          "label": "Play distinctive sound",
          "type": "boolean",
          "default": false
        },
        {
          "id": "loop-sound",
          "label": "Loop audible chime",
          "type": "boolean",
          "default": false,
          "help": "Requires Play distinctive sound. Repeats the selected template’s chime until this notice closes; TV volume and mute are unchanged."
        }
      ]
    },
    {
      "id": "launch-app",
      "name": "Launch installed app",
      "parameters": [
        {
          "id": "id",
          "label": "Reported app ID",
          "type": "string",
          "required": true,
          "maxLength": 128
        },
        {
          "id": "mode",
          "label": "Launch mode",
          "type": "string",
          "default": "DEEP_LINK",
          "enum": [
            "DEEP_LINK",
            "NATIVE_LAUNCH"
          ],
          "section": "Playback",
          "advanced": true
        },
        {
          "id": "arguments",
          "label": "App arguments",
          "type": "string",
          "default": "",
          "maxLength": 2048,
          "section": "Playback",
          "advanced": true
        }
      ],
      "description": "Send one explicit TV operation without retry. Supported behavior depends on this TV’s firmware."
    },
    {
      "id": "close-app",
      "name": "Close installed app",
      "description": "Close only the selected app by its reported ID. Reads its running status first; unsupported firmware fails without sending Exit or Home. No wake or retry.",
      "parameters": [
        {
          "id": "id",
          "label": "Reported app ID",
          "type": "string",
          "required": true,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "help": "Use the exact installed app ID. Closing a background app does not send keys to another app."
        }
      ]
    },
    {
      "id": "play-youtube",
      "name": "Play YouTube video",
      "description": "Play a Video ID through the TV YouTube app. Requires YouTube playback enabled in Samsung TV Settings; no wake or retry.",
      "parameters": [
        {
          "id": "video-id",
          "label": "Video ID",
          "type": "string",
          "required": true,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]{11}$",
          "help": "Select Video ID from a Video released Event, or enter an eleven-character ID."
        },
        {
          "id": "app-id",
          "label": "YouTube app ID",
          "type": "string",
          "required": true,
          "maxLength": 128,
          "default": "111299001912",
          "pattern": "^[\\w.-]{1,128}$",
          "section": "Playback",
          "advanced": true
        }
      ]
    },
    {
      "id": "open-browser",
      "name": "Open TV browser URL",
      "parameters": [
        {
          "id": "url",
          "label": "HTTP or HTTPS URL",
          "type": "string",
          "required": true,
          "maxLength": 2048
        }
      ],
      "description": "Send one explicit TV operation without retry. Supported behavior depends on this TV’s firmware."
    },
    {
      "id": "play-media",
      "name": "Play media URL",
      "parameters": [
        {
