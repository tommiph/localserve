  "actions": [
    {
      "id": "refresh",
      "name": "Refresh TV readings",
      "parameters": [],
      "description": "Read the configured TV without changing its screen."
    },
    {
      "id": "refresh-apps",
      "name": "Read installed apps",
      "parameters": [],
      "description": "Read the configured TV without changing its screen."
    },
    {
      "id": "key",
      "name": "Send remote key",
      "parameters": [
        {
          "id": "key",
          "label": "Remote key",
          "type": "string",
          "required": true,
          "default": "KEY_HOME",
          "enum": [
