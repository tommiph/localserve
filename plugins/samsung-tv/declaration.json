{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "samsung-tv",
  "name": "Samsung TV",
  "version": "1.7.0",
  "description": "Local Samsung TV readings, apps and remote controls",
  "icon": "display",
  "runtime": {
    "entry": "server/index.mjs"
  },
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes"
  },
  "settings": [
    {
      "id": "host",
      "label": "TV address",
      "type": "string",
      "default": "",
      "maxLength": 15,
      "help": "This TV’s private IPv4 address. No network discovery or fallback target.",
      "section": "Connection"
    },
    {
      "id": "port",
      "label": "Remote port",
      "type": "number",
      "default": 8002,
      "enum": [
        8002,
        8001
      ],
      "enumLabels": [
        "8002 · TLS",
        "8001 · plain local WebSocket"
      ],
      "section": "Connection",
      "advanced": true
    },
    {
      "id": "fingerprint",
      "label": "TV certificate fingerprint (SHA-256)",
      "type": "string",
      "default": "",
      "maxLength": 95,
      "help": "Port 8002 remote actions verify this exact self-signed certificate before sending the token. Changing it never happens automatically.",
      "section": "Connection",
      "advanced": true
    },
    {
      "id": "remote-name",
      "label": "Remote name",
      "type": "string",
      "default": "Living room remote",
      "maxLength": 100,
      "help": "Name presented to the TV by this Sormus installation.",
      "section": "Connection",
      "advanced": true
    },
    {
      "id": "command-interval-ms",
      "label": "Remote command interval (ms)",
      "type": "number",
      "default": 100,
      "min": 0,
      "max": 5000,
      "help": "Minimum spacing between remote commands, in milliseconds. Use 0 for no extra spacing. Connection and delivery time still apply. Applies to remote pages and Task actions; status reads are unaffected.",
      "section": "Remote"
    },
    {
      "id": "token",
      "label": "Saved TV pairing token",
      "type": "string",
      "format": "secret",
      "default": "",
      "maxLength": 512,
      "help": "Optional replacement: an already authorized TV token. After a successful remote read/action, clear this setting; the Windows-protected copy remains. Nonempty settings are private plaintext. Status polls do not pair.",
      "section": "Connection",
      "advanced": true
    },
    {
      "id": "mac",
      "label": "Wired MAC address",
      "type": "string",
      "default": "",
      "maxLength": 17,
      "help": "Used only by the explicit Wake TV action. A wake packet does not confirm power-on.",
      "section": "Power",
      "advanced": true
    },
    {
      "id": "poll-minutes",
      "label": "Polling interval",
      "type": "number",
      "default": 1,
      "min": 0.5,
      "max": 5,
      "enum": [
        0.5,
        1,
        5
      ],
      "enumLabels": [
        "30 seconds",
        "1 minute",
        "5 minutes"
      ],
      "section": "Readings"
    },
    {
      "id": "youtube-playback",
      "label": "YouTube playback",
      "type": "boolean",
      "default": false,
      "help": "Allows Play YouTube video to read this TV’s private screen ID and send it to YouTube for a temporary playback session. No Google account or API key is used. Off by default.",
      "section": "YouTube"
    },
    {
      "id": "youtube-port",
      "label": "YouTube control port",
      "type": "number",
      "default": 8080,
      "min": 1,
      "max": 65535,
      "help": "Explicit port on this same TV for /ws/app/YouTube. No discovery, fallback port or automatic retry.",
      "section": "YouTube",
      "advanced": true
    }
  ],
