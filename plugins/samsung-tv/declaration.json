  "connectionSetup": {
    "addressSetting": "host",
    "testAction": "test-connection",
    "repairAction": "repair-connection",
    "help": "Status polling and remote control use separate connections. Test connection verifies remote authorization without changing the TV screen. After an IP change, keep the saved certificate and use Update pairing address."
  },
  "settingsGuide": {
    "title": "Connection setup and recovery",
    "sections": [
      {
        "title": "Connect",
        "steps": [
          "Enter the TV address, remote port and remote name. For TLS port 8002, supply the verified SHA-256 certificate fingerprint.",
          "Enter an already authorized pairing token if no protected pairing is saved. Enable the plugin and select Test connection.",
          "After a successful test, clear the token field. The protected pairing remains available on this Windows account."
        ]
      },
      {
        "title": "Remote response speed",
        "steps": [
          "Set Remote command interval (ms) to control minimum spacing between commands. The default is 100 ms; 0 disables extra spacing. Increase it if the TV drops rapid input.",
          "Connection establishment and delivery still take time. Controls follow a submitted command’s status promptly, without waiting for the ordinary reading refresh. Commands remain serialized and are never retried."
        ]
      },
      {
        "title": "Address changed",
        "steps": [
          "Change TV address and keep the verified certificate fingerprint. Select Update pairing address.",
          "The protected pairing must already contain a verified TLS certificate. For an older pairing, test the previous address first if available, or supply an authorized replacement token at the new address and select Test connection.",
          "Port 8001 cannot verify a certificate. Supply an authorized replacement token after changing its address."
        ]
      },
      {
        "title": "Connection failed",
        "steps": [
          "Confirm the TV is on, is on the same network and has the saved address. Status polling does not prove remote authorization.",
          "If authorization was rejected, check the TV’s external-device permissions and obtain an authorized replacement token. If the certificate changed, verify the physical TV before replacing the fingerprint.",
          "Tests do not wake the TV, launch apps or replay failed Tasks."
        ]
      }
    ]
  }
}
