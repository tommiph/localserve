          "label": "Occurrence",
          "type": "string",
          "required": true,
          "maxLength": 100
        },
        {
          "id": "hex",
          "label": "ICAO / address",
          "type": "string",
          "required": true,
          "maxLength": 7
        },
        {
          "id": "callsign",
          "label": "Callsign",
          "type": "string",
          "maxLength": 16
        },
        {
          "id": "registration",
          "label": "Registration",
          "type": "string",
          "maxLength": 24
        },
        {
          "id": "type",
          "label": "Aircraft type",
          "type": "string",
          "maxLength": 12
        },
        {
          "id": "distance",
          "label": "Calculated distance (NM)",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 250
        },
        {
          "id": "altitude",
          "label": "Reported barometric altitude (ft)",
          "type": "number",
          "min": -2000,
          "max": 100000
        },
        {
          "id": "speed",
          "label": "Reported ground speed (kt)",
          "type": "number",
          "min": 0,
          "max": 3000
        },
        {
          "id": "track",
          "label": "Reported ground track (degrees)",
          "type": "number",
          "min": 0,
          "max": 360
        },
        {
          "id": "ground",
          "label": "Reported on ground",
          "type": "boolean"
        },
        {
          "id": "latitude",
          "label": "Reported latitude",
          "type": "number",
          "min": -90,
          "max": 90
        },
        {
          "id": "longitude",
          "label": "Reported longitude",
          "type": "number",
          "min": -180,
          "max": 180
        },
        {
          "id": "position-age",
