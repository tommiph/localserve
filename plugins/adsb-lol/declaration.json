          "max": 300
        },
        {
          "id": "squawk",
          "label": "Reported squawk",
          "type": "string",
          "maxLength": 4
        },
        {
          "id": "emergency",
          "label": "Reported emergency",
          "type": "string",
          "maxLength": 32
        }
      ]
