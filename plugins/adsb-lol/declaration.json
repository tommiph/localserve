          "id": "area-id",
          "label": "Area",
          "type": "string",
          "maxLength": 64,
          "default": ""
        }
      ]
    }
  ],
  "events": [
    {
      "id": "reading-updated",
      "name": "Aircraft reading updated",
      "testAction": "refresh",
      "description": "A successful area read, including empty results. Counts use qualifying recent positions.",
      "payload": [
        {
          "id": "area-id",
          "label": "Area",
          "type": "string",
          "required": true,
          "maxLength": 64
        },
        {
          "id": "area-name",
          "label": "Area name",
          "type": "string",
          "required": true,
          "maxLength": 32
