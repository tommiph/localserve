{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "adsb-lol",
  "name": "adsb.lol",
  "version": "1.1.0",
  "description": "Nearby aircraft from adsb.lol public position reports",
  "icon": "plane",
  "defaultCardLayout": "table",
  "runtime": {
    "entry": "server/index.mjs",
    "stateMaxBytes": 1048576
  },
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes",
    "targetParameter": "area-id"
  },
  "instances": {
    "setting": "areas",
    "stateKey": "areas",
    "eventKey": "area-id"
  },
  "attribution": {
    "label": "Aircraft data: adsb.lol",
    "url": "https://www.adsb.lol/",
    "licenseLabel": "ODbL 1.0",
    "licenseUrl": "https://opendatacommons.org/licenses/odbl/1-0/",
    "notice": "Aircraft positions may be incomplete or delayed. Not for navigation."
  },
  "settings": [
    {
      "id": "poll-minutes",
      "label": "Polling interval",
      "type": "number",
      "required": true,
      "default": 2,
      "min": 1,
      "max": 15,
      "enum": [
        1,
        2,
        5,
        10,
        15
      ],
      "enumLabels": [
        "1 minute",
        "2 minutes",
        "5 minutes",
        "10 minutes",
        "15 minutes"
      ],
      "help": "Per enabled area, staggered serial reads. Provider backoff can slow refreshes."
    },
    {
      "id": "areas",
      "label": "Areas",
      "type": "list",
      "itemLabel": "area",
      "maxItems": 20,
      "default": [],
      "uniqueBy": [
        "id",
        "name"
      ],
      "help": "Named search areas. Coordinates are sent to adsb.lol only when this plugin and area are enabled or explicitly refreshed.",
      "fields": [
        {
          "id": "id",
          "label": "Area ID",
          "type": "string",
          "required": true,
          "format": "identifier",
          "maxLength": 64
        },
        {
          "id": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "maxLength": 32
        },
        {
          "id": "coordinates",
          "label": "Coordinates (latitude, longitude)",
          "type": "string",
          "required": true,
          "maxLength": 64,
          "defaultFrom": "server-location",
          "help": "Decimal degrees, for example 60.3,25.0. New entries prefill Server location; saved areas remain independent."
        },
        {
          "id": "radius",
          "label": "Radius (nautical miles)",
          "type": "number",
          "required": true,
          "default": 25,
          "min": 1,
          "max": 250
        },
        {
          "id": "position-age",
          "label": "Maximum reported position age",
          "type": "number",
          "required": true,
          "default": 60,
          "min": 30,
          "max": 300,
          "enum": [
            30,
            60,
            120,
            300
          ],
          "enumLabels": [
            "30 seconds",
            "1 minute",
            "2 minutes",
            "5 minutes"
          ]
        },
        {
          "id": "enabled",
          "label": "Enabled",
          "type": "boolean",
          "required": true
        }
      ]
    }
  ],
  "cardFields": [
    {
      "id": "aircraft-count",
      "label": "Aircraft with recent positions",
      "type": "number",
      "icon": "plane",
      "source": {
        "kind": "state",
        "key": "aircraft-count"
      }
    },
    {
      "id": "row-count",
      "label": "Displayed aircraft",
      "type": "number",
      "icon": "plane",
      "source": {
        "kind": "state",
        "key": "row-count"
      }
    },
    {
      "id": "list-limited",
      "label": "List limited to ten aircraft",
      "type": "boolean",
      "icon": "plane",
      "source": {
        "kind": "state",
        "key": "list-limited"
      }
    },
    {
      "id": "excluded-count",
      "label": "Reports excluded by position/radius/age",
      "type": "number",
      "icon": "plane",
      "source": {
        "kind": "state",
        "key": "excluded-count"
      }
    },
    {
      "id": "received-at",
      "label": "Successful reception",
      "type": "timestamp",
      "icon": "clock",
      "source": {
        "kind": "state",
        "key": "received-at"
      }
    },
    {
      "id": "attempted-at",
