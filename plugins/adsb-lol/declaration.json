          "label": "Nearest calculated distance (NM)",
          "type": "number",
          "min": 0,
          "max": 250
        }
      ]
    },
    {
      "id": "aircraft-detected",
      "name": "Aircraft first observed",
      "testAction": "refresh",
      "occurrenceKey": "occurrence-id",
      "description": "New address in a successful area response with a qualifying position. First/changed-area reads baseline; at most ten events per refresh. Not a confirmed border crossing.",
      "payload": [
        {
          "id": "area-id",
          "label": "Area",
          "type": "string",
          "required": true,
          "maxLength": 64
        },
        {
          "id": "area-name",
          "label": "Area name",
          "type": "string",
          "required": true,
          "maxLength": 32
        },
        {
