{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "fingrid",
  "name": "Fingrid",
  "version": "1.2.1",
  "description": "Finland electricity system datasets and latest readings",
  "icon": "bolt",
  "runtime": {
    "entry": "server/index.mjs",
    "stateMaxBytes": 1048576
  },
  "defaultCardLayout": "table",
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes",
    "targetParameter": "source-id"
  },
  "instances": {
    "setting": "datasets",
    "stateKey": "datasets",
    "eventKey": "source-id"
  },
  "attribution": {
    "label": "Source Fingrid / data.fingrid.fi",
    "url": "https://data.fingrid.fi/en/about",
    "licenseLabel": "CC BY 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
    "notice": "Values unchanged; labels and dates formatted. Other publishers may have dataset-specific licenses. Fingrid does not warrant completeness or accuracy."
  },
  "settings": [
    {
      "id": "api-key",
      "label": "Fingrid API key",
      "type": "string",
      "format": "secret",
      "default": "",
      "maxLength": 128,
      "pattern": "^[a-fA-F0-9]{0,128}$",
      "help": "Stored privately in this plugin, masked here and excluded from Cards. Sent only as the x-api-key header to data.fingrid.fi."
    },
    {
      "id": "api-paused",
      "label": "Pause API calls",
      "type": "boolean",
      "required": true,
      "default": false
    },
    {
      "id": "poll-minutes",
      "label": "Polling interval",
      "type": "number",
      "required": true,
      "default": 3,
      "min": 3,
      "max": 60,
      "enum": [
        3,
        5,
        15,
        30,
        60
      ],
      "enumLabels": [
        "3 minutes",
        "5 minutes",
        "15 minutes",
        "30 minutes",
        "1 hour"
      ],
      "help": "Per enabled Dataset, staggered serially. API reads are spaced by at least two seconds. Many sources may slow polling to stay within the local request budget."
    },
    {
      "id": "language",
      "label": "Dataset language",
      "type": "string",
      "required": true,
      "default": "en",
      "enum": [
        "en",
        "fi"
      ],
      "enumLabels": [
        "English",
        "Finnish"
      ]
    },
    {
      "id": "datasets",
      "label": "Datasets",
      "type": "list",
      "itemLabel": "dataset",
      "maxItems": 20,
      "default": [],
      "uniqueBy": [
        "id",
        "name",
        "query"
      ],
      "help": "Add a named time-series dataset from data.fingrid.fi. Separate readings, Cards and Task events. Copies start disabled.",
      "fields": [
        {
          "id": "id",
          "label": "Source ID",
          "type": "string",
          "required": true,
          "format": "identifier",
          "maxLength": 64
        },
        {
          "id": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "maxLength": 32
        },
        {
          "id": "query",
          "label": "Dataset ID",
          "type": "string",
          "required": true,
          "default": "193",
          "maxLength": 10,
          "pattern": "^[1-9][0-9]{0,9}$",
          "help": "Enter the numeric Dataset ID shown on its Fingrid dataset page. Only time-series datasets are supported; units and period times come from the API.",
          "suggestions": [
            {
              "value": "193",
              "label": "Electricity consumption · real-time"
            },
            {
              "value": "192",
              "label": "Electricity production · real-time"
            },
            {
              "value": "181",
              "label": "Wind production · real-time"
            },
            {
              "value": "177",
              "label": "Grid frequency · real-time"
            },
            {
              "value": "188",
              "label": "Nuclear production · real-time"
            },
            {
              "value": "191",
              "label": "Hydro production · real-time"
            },
            {
              "value": "124",
              "label": "Electricity consumption · 15 minutes"
            },
            {
              "value": "265",
              "label": "Consumption emission factor"
            }
          ]
        },
        {
          "id": "enabled",
          "label": "Enabled",
          "type": "boolean",
          "required": true
        }
      ]
    }
  ],
  "cardFields": [
    {
      "id": "readings",
      "label": "Observed readings",
      "type": "table",
      "icon": "chart-line",
      "columns": [
