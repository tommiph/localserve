          "required": true,
          "maxLength": 120
        },
        {
          "id": "temperature-c",
          "label": "Temperature (°C)",
          "type": "number",
          "required": true,
          "min": -150,
          "max": 100
        },
        {
          "id": "wind-speed-kmph",
          "label": "Wind speed (km/h)",
          "type": "number",
          "min": 0,
          "max": 1000
        },
        {
          "id": "raining",
          "label": "Rain reported",
          "type": "boolean"
        },
        {
          "id": "humidity-percent",
          "label": "Humidity (%)",
          "type": "number",
          "min": 0,
          "max": 100
        },
        {
          "id": "precipitation-mm",
          "label": "Precipitation (mm)",
          "type": "number",
          "min": 0,
          "max": 10000
        }
      ]
    }
