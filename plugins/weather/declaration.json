{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "weather",
  "name": "Weather",
  "version": "1.3.0",
  "description": "Current weather from wttr.in",
  "icon": "sun",
  "runtime": {
    "entry": "server/index.mjs"
  },
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes",
    "targetParameter": "location-id"
  },
  "instances": {
    "setting": "locations",
    "stateKey": "locations",
    "eventKey": "location-id",
    "legacySetting": "city",
    "legacyId": "legacy-city"
  },
  "settings": [
    {
      "id": "poll-minutes",
      "label": "Polling interval",
      "type": "number",
      "default": 60,
      "min": 15,
      "max": 60,
      "enum": [
        15,
        30,
        45,
        60
      ],
      "enumLabels": [
        "15 minutes",
        "30 minutes",
        "45 minutes",
        "1 hour"
      ],
      "help": "Applies to each enabled location. Requests are staggered across the interval."
    },
    {
      "id": "locations",
      "label": "Locations",
      "type": "list",
      "itemLabel": "location",
      "maxItems": 20,
      "default": [],
      "uniqueBy": [
        "id",
        "name",
        "query"
      ],
      "help": "Add named locations for separate readings, card fields, and Task events. New Location inputs default to Server location coordinates when configured.",
      "fields": [
        {
          "id": "id",
          "label": "Location ID",
          "type": "string",
          "required": true,
          "format": "identifier",
          "maxLength": 64
        },
        {
          "id": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "maxLength": 32
        },
        {
          "id": "query",
          "label": "Location",
          "type": "string",
          "required": true,
          "maxLength": 120,
          "defaultFrom": "server-location",
          "pattern": "^/?[^/?:#]+$",
          "help": "Supported location formats (the leading / is optional):\n/paris — City name\n/Eiffel+tower — Any location (+ for spaces)\n/Москва — Unicode name in any language\n/muc — Airport code (3 letters)\n/@stackoverflow.com — Domain name\n/94107 — Area code\n/-78.46,106.79 — GPS coordinates\nNew entries default to Server location coordinates; saved locations remain editable and independent."
        },
        {
          "id": "enabled",
          "label": "Enabled",
          "type": "boolean",
          "required": true
        }
      ]
    }
  ],
  "cardFields": [
    {
      "id": "requested-city",
      "label": "Requested location",
      "type": "string",
      "icon": "house",
      "source": {
        "kind": "state",
        "key": "requested-city"
      }
    },
    {
      "id": "resolved-area",
      "label": "Nearest area",
      "type": "string",
      "icon": "house",
      "source": {
        "kind": "state",
        "key": "resolved-area"
      }
    },
    {
      "id": "region",
      "label": "Region",
      "type": "string",
      "icon": "house",
      "source": {
        "kind": "state",
        "key": "region"
      }
    },
    {
      "id": "country",
      "label": "Country",
      "type": "string",
      "icon": "house",
      "source": {
        "kind": "state",
        "key": "country"
      }
    },
    {
      "id": "conditions",
      "label": "Conditions",
      "type": "string",
      "icon": "sun",
      "source": {
        "kind": "state",
        "key": "conditions"
      }
    },
    {
      "id": "temperature-c",
      "label": "Temperature (°C)",
      "type": "number",
      "icon": "gauge",
      "source": {
        "kind": "state",
        "key": "temperature-c"
      }
    },
    {
      "id": "feels-like-c",
      "label": "Feels like (°C)",
      "type": "number",
      "icon": "gauge",
      "source": {
        "kind": "state",
        "key": "feels-like-c"
      }
    },
    {
      "id": "humidity-percent",
      "label": "Humidity (%)",
      "type": "number",
      "icon": "gauge",
      "source": {
        "kind": "state",
        "key": "humidity-percent"
      }
    },
    {
      "id": "wind-speed-kmph",
      "label": "Wind speed (km/h)",
      "type": "number",
      "icon": "gauge",
      "source": {
        "kind": "state",
        "key": "wind-speed-kmph"
      }
    },
    {
      "id": "wind-direction",
      "label": "Wind direction",
      "type": "string",
      "icon": "satellite-dish",
      "source": {
        "kind": "state",
        "key": "wind-direction"
      }
    },
    {
      "id": "precipitation-mm",
      "label": "Precipitation (mm)",
      "type": "number",
      "icon": "gauge",
      "source": {
        "kind": "state",
        "key": "precipitation-mm"
      }
    },
    {
      "id": "pressure-hpa",
      "label": "Pressure (hPa)",
      "type": "number",
      "icon": "gauge",
      "source": {
        "kind": "state",
        "key": "pressure-hpa"
      }
    },
    {
      "id": "visibility-km",
      "label": "Visibility (km)",
      "type": "number",
      "icon": "eye",
      "source": {
        "kind": "state",
        "key": "visibility-km"
      }
    },
    {
      "id": "cloud-cover-percent",
      "label": "Cloud cover (%)",
      "type": "number",
      "icon": "sun",
      "source": {
        "kind": "state",
        "key": "cloud-cover-percent"
      }
    },
    {
      "id": "uv-index",
      "label": "UV index",
      "type": "number",
      "icon": "sun",
      "source": {
        "kind": "state",
        "key": "uv-index"
      }
    },
    {
      "id": "weather-code",
      "label": "Weather code",
      "type": "string",
      "icon": "code",
      "source": {
        "kind": "state",
        "key": "weather-code"
      }
    },
    {
      "id": "raining",
      "label": "Rain reported",
      "type": "boolean",
      "icon": "sun",
      "source": {
        "kind": "state",
        "key": "raining"
      }
    },
    {
      "id": "updated-at",
      "label": "Last successful refresh",
      "type": "timestamp",
      "icon": "clock",
      "source": {
        "kind": "state",
        "key": "updated-at"
      }
    }
  ],
  "actions": [
    {
      "id": "refresh",
      "name": "Refresh weather",
      "description": "Fetch current conditions from wttr.in for one enabled location.",
      "parameters": [
        {
          "id": "location-id",
          "label": "Location",
          "type": "string",
          "default": "",
          "maxLength": 64
        }
      ]
    }
  ],
  "events": [
    {
      "id": "weather-updated",
      "name": "Weather updated",
      "description": "Current conditions were fetched and saved successfully.",
      "testAction": "refresh",
      "payload": [
        {
          "id": "location-id",
          "label": "Location ID",
          "type": "string",
          "required": true,
          "maxLength": 64
        },
        {
          "id": "location-name",
