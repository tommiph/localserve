{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "oculus-go",
  "name": "Oculus Go",
  "version": "1.3.0",
  "description": "Wi-Fi headset diagnostics and a manual APK library",
  "icon": "vr-cardboard",
  "runtime": {
    "entry": "server/index.mjs"
  },
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes"
  },
  "settings": [
    {
      "id": "address",
      "label": "Wi-Fi address",
      "type": "string",
      "default": "",
      "maxLength": 32,
      "help": "The headset’s local IPv4 address and ADB port, for example 192.168.0.7:5555. No automatic network scan."
    },
    {
      "id": "serial",
      "label": "Headset serial",
      "type": "string",
      "default": "",
      "maxLength": 100,
      "help": "Readings require this exact serial; an address reused by another device is rejected."
    },
    {
      "id": "adb-key",
      "label": "Authorized ADB key (Base64)",
      "type": "string",
      "format": "secret",
      "default": "",
      "maxLength": 4000,
      "help": "Optional replacement: Base64 of a 2048-bit RSA PEM key already authorized by the headset. After a successful refresh, clear this field; the Windows-protected key remains. Nonempty settings are saved privately as plaintext."
    },
    {
      "id": "poll-minutes",
      "label": "Polling interval",
      "type": "number",
      "default": 0.25,
      "min": 0.25,
      "max": 1,
      "enum": [
        0.25,
        0.5,
        1
      ],
      "enumLabels": [
        "15 seconds",
        "30 seconds",
        "1 minute"
      ],
      "help": "Serial supervised reads. Failed polls retain successful readings and do not retry immediately."
    },
    {
      "id": "library-enabled",
      "label": "APK library",
      "type": "boolean",
      "default": false,
      "help": "Enable the VR library page for manual APK installation and confirmed removal. No automatic package operations."
    },
    {
      "id": "library-folder",
      "label": "APK library folder",
      "type": "string",
      "default": "library/oculus-go",
      "maxLength": 500,
      "help": "Folder containing your standalone APK files. Relative paths start at the Localserve folder; an absolute path may select your own external library. Subfolder links are ignored. APKs are private user content."
    },
    {
      "id": "home-vr-enabled",
      "label": "Home VR headset access",
      "type": "boolean",
      "default": false,
      "help": "Allow the existing Home VR app to browse and manage this library with its matching protected token. Use Change address in Home VR to enter this server IP and port. No automatic discovery or package changes."
    },
    {
      "id": "home-vr-token",
      "label": "Home VR token (optional replacement)",
      "type": "string",
      "format": "secret",
      "default": "",
      "maxLength": 512,
      "help": "Use the token belonging to your own Home VR APK. Clear this field after saving it from the VR library page; the Windows-protected copy remains. Nonempty Settings values are stored privately as plaintext."
    }
  ],
  "actions": [
    {
      "id": "refresh",
      "name": "Refresh diagnostics",
      "description": "Read the configured headset’s battery, state, app, storage and sensors.",
      "parameters": []
    },
    {
      "id": "test-connection",
      "name": "Test connection",
      "description": "Verify saved authorization and device identity without changing the screen or emitting Task events.",
      "parameters": [],
      "settingsOnly": true
    },
    {
      "id": "library-inventory",
      "name": "Read installed apps",
      "description": "Manual VR library operation. Not available to Tasks.",
      "settingsOnly": true,
      "timeoutSeconds": 30,
      "parameters": []
    },
    {
      "id": "library-inspect",
      "name": "Inspect installed app",
      "description": "Manual VR library operation. Not available to Tasks.",
      "settingsOnly": true,
      "timeoutSeconds": 30,
      "parameters": [
        {
          "id": "package",
          "label": "Package name",
          "type": "string",
          "required": true,
          "maxLength": 200
        }
      ]
    },
    {
      "id": "library-install",
      "name": "Install APK",
      "description": "Manual VR library operation. Not available to Tasks.",
      "settingsOnly": true,
      "timeoutSeconds": 1200,
      "parameters": [
        {
          "id": "id",
          "label": "Library file",
          "type": "string",
          "required": true,
          "maxLength": 24
        }
      ]
    },
    {
      "id": "library-uninstall",
      "name": "Remove installed app",
      "description": "Manual VR library operation. Not available to Tasks.",
      "settingsOnly": true,
      "timeoutSeconds": 120,
      "parameters": [
        {
          "id": "package",
          "label": "Package name",
          "type": "string",
          "required": true,
          "maxLength": 200
        }
      ]
    }
  ],
  "events": [
    {
      "id": "status-updated",
      "name": "Status updated",
      "testAction": "refresh",
      "description": "A successful diagnostic refresh; filtered Task rules retain true-edge behavior.",
      "payload": [
        {
          "id": "state",
          "type": "string",
          "maxLength": 32
        },
        {
          "id": "battery",
          "type": "number",
          "min": 0,
          "max": 100
        },
        {
          "id": "charging",
          "type": "boolean"
        },
        {
          "id": "package",
          "type": "string",
          "maxLength": 200
        }
      ]
    },
    {
      "id": "headset-changed",
      "name": "Headset changed",
      "occurrenceKey": "change-id",
      "description": "An observed headset-state or foreground-package transition, committed before dispatch.",
      "payload": [
        {
          "id": "state",
          "type": "string",
          "maxLength": 32
        },
        {
          "id": "battery",
          "type": "number",
          "min": 0,
          "max": 100
        },
        {
          "id": "charging",
          "type": "boolean"
        },
        {
          "id": "package",
          "type": "string",
          "maxLength": 200
        },
        {
          "id": "change-id",
          "type": "string",
          "required": true,
          "maxLength": 100
        }
      ]
    }
  ],
