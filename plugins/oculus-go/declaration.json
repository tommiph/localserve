  "connectionSetup": {
    "addressSetting": "address",
    "testAction": "test-connection",
    "help": "Test connection verifies the saved ADB key and headset serial without emitting Task events. After an IP change, edit Wi-Fi address and test again. If wireless ADB is disabled, enable it on the headset first."
  },
  "settingsGuide": {
    "title": "Connection setup and recovery",
    "sections": [
      {
        "title": "Connect",
        "steps": [
          "Enable wireless ADB on the headset and authorize this computer’s ADB key. Localserve uses legacy ADB TCP, not Android’s wireless pairing-code flow.",
          "Enter the headset Wi-Fi address with port, normally :5555, and its exact serial. Supply an already authorized RSA key as Base64 if no protected key is saved.",
          "Enable the plugin and select Test connection. After success, clear the key field; the protected key remains available on this Windows account."
        ]
      },
      {
        "title": "Reconnect",
        "steps": [
          "If the headset address changes, update Wi-Fi address and select Test connection. The saved key is reused and the serial must match.",
          "If unavailable, check the current address, network and whether wireless ADB is enabled. If necessary, enable wireless ADB again through your device setup tools. Localserve does not control the shared PC ADB service.",
          "If the key is rejected, authorize it on the headset or supply an already authorized replacement. A serial mismatch means the configured device identity must be checked; do not replace it just to bypass the check.",
          "Scheduled diagnostics resume on the next poll when the device is available. A failed connection does not prove the headset is asleep or powered off."
        ]
      },
      {
        "title": "VR library",
        "steps": [
          "Enable APK library, set the folder containing your own APKs, then open VR library in the server menu. Scan finds standalone APKs; no files are uploaded or downloaded from the internet.",
          "Read installed apps to inspect the configured headset. Install replaces an existing compatible version without requesting a downgrade. Uninstall requires confirmation and deletes the application’s saved data.",
          "For an existing Home VR APK, enable Home VR headset access and supply its matching token. In the VR library page select Save Home VR token, then clear the replacement setting. On the headset use Settings → Change address and enter this server IP:port."
        ]
      }
    ]
  }
}
