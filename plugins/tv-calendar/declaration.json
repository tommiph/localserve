{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "tv-calendar",
  "name": "TV Calendar",
  "version": "1.5.0",
  "icon": "live-tv",
  "description": "Follow TV shows, track watched episodes and plan your viewing",
  "defaultCardLayout": "table",
  "runtime": {
    "entry": "server/index.mjs",
    "stateMaxBytes": 1048576
  },
  "polling": {
    "actionId": "refresh",
    "intervalSetting": "poll-minutes"
  },
  "attribution": {
    "label": "TVmaze",
    "url": "https://www.tvmaze.com",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/",
    "licenseLabel": "CC BY-SA",
    "notice": "Episode listings provided by TVmaze. Reported release dates do not guarantee local availability."
  },
  "settings": [
    {
      "id": "pick-genre",
      "label": "Daily picks genre",
      "type": "string",
      "default": "",
      "enum": [
        "",
        "Science-Fiction",
        "Drama",
        "Comedy",
        "Thriller",
        "Fantasy",
        "Action",
        "Crime",
        "Mystery",
        "Adventure"
      ],
      "enumLabels": [
        "All genres",
        "Science fiction",
        "Drama",
        "Comedy",
        "Thriller",
        "Fantasy",
        "Action",
        "Crime",
        "Mystery",
        "Adventure"
      ],
      "section": "Daily suggestions"
    },
    {
      "id": "pick-genres",
      "label": "Preferred genres",
      "type": "string",
      "maxLength": 250,
      "pattern": "^(?:(?:Science-Fiction|Drama|Comedy|Thriller|Fantasy|Action|Crime|Mystery|Adventure)(?:,(?!$)|$))*$",
      "section": "Daily suggestions",
      "help": "Select any genres for daily suggestions. An empty selection includes all genres."
    },
    {
      "id": "pick-ended",
      "label": "Include completed series in daily picks",
      "type": "boolean",
      "default": true,
      "section": "Daily suggestions",
      "help": "Daily picks are discovery suggestions, not broadcasts or subscription availability. Followed shows are excluded."
    },
    {
      "id": "poll-minutes",
      "label": "Episode check interval",
      "type": "number",
      "required": true,
      "default": 1,
      "min": 1,
      "max": 5,
      "enum": [
        1,
        2,
        5
      ],
      "enumLabels": [
        "1 minute",
        "2 minutes",
        "5 minutes"
      ],
      "help": "Checks cached air times for Task Events. A missed interval or restart does not replay old episodes."
    },
    {
      "id": "refresh-hours",
      "label": "Show metadata refresh",
      "type": "number",
      "required": true,
      "default": 6,
      "min": 6,
      "max": 24,
      "enum": [
        6,
        12,
        24
      ],
      "enumLabels": [
        "6 hours",
        "12 hours",
        "24 hours"
      ],
      "help": "One due show is fetched per check. Cached listings remain visible during outages."
    },
    {
      "id": "shows",
      "label": "Followed shows",
      "type": "list",
      "maxItems": 20,
      "itemLabel": "show",
      "default": [],
      "uniqueBy": [
        "id",
        "tvmaze-id"
      ],
      "help": "Find a show in Calendar. Listings follow the original network or streaming release; your local subscription may differ.",
      "fields": [
        {
          "id": "id",
          "label": "Show entry ID",
          "type": "string",
          "required": true,
          "maxLength": 64,
          "format": "identifier"
        },
        {
          "id": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "maxLength": 32
        },
        {
          "id": "tvmaze-id",
          "label": "TVmaze show ID",
          "type": "string",
          "required": true,
          "maxLength": 9,
          "pattern": "^[1-9]\\d{0,8}$"
        },
        {
          "id": "enabled",
          "label": "Enabled",
          "type": "boolean",
          "required": true
        }
      ]
    }
  ],
  "settingsGuide": {
    "title": "TV Calendar setup",
    "sections": [
      {
        "title": "Follow shows",
        "steps": [
          "Open For you for four daily discovery picks. Follow saves a show immediately; followed shows are excluded from new picks. Choose genre and completed-series preferences in Settings. Daily TV suggestions Cards show the same selection.",
          "Open Discover shows for a starter selection across science-fiction, drama, comedy and thrillers. Filter the selection by genre or follow several shows with one click each. Suggestions are not followed automatically. Their checked date is shown; following loads current episode listings.",
          "Choose Find shows or Add show. Search by title, or leave the title empty to browse shows airing today. Filter by genre or status, then choose Follow for each show you want; every click saves immediately and keeps the results open.",
          "Close the finder when finished. Followed shows are enabled and refresh on the next episode check, or choose Refresh show in Shows. Edit a followed show to change its name or Enabled setting.",
          "Choose Month or Agenda. The server timezone and selected 12/24-hour format apply. Mark episodes watched from their popup."
        ]
      },
      {
        "title": "Tasks and Cards",
        "steps": [
          "Use Episode airing in a Task to receive show name, episode title, season, episode number, air time, network and TVmaze link. Initial reads and restarts do not replay old releases.",
          "Create a Card using Upcoming television. Publish it through your usual Vista or Controller setup.",
          "Only public TVmaze endpoints are used. No account or API key is required. Listings are attributed to TVmaze under CC BY-SA."
        ]
      }
    ]
  },
