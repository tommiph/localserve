  "actions": [
    {
      "id": "refresh",
      "name": "Check TV episodes",
      "description": "Check cached episode times and refresh one due show.",
      "parameters": []
    },
    {
      "id": "lookup-show",
      "name": "Find shows",
      "settingsOnly": true,
      "parameters": [
        {
          "id": "query",
          "label": "Show title",
          "type": "string",
          "required": false,
          "maxLength": 100
        },
        {
          "id": "genre",
          "label": "Genre",
          "type": "string",
          "maxLength": 40
        },
        {
          "id": "status",
          "label": "Show status",
          "type": "string",
          "enum": [
            "",
            "Running",
            "Ended",
            "To Be Determined"
          ],
          "enumLabels": [
            "Any status",
            "Running",
            "Ended",
            "To be determined"
          ]
        },
        {
          "id": "source",
          "label": "Browse shows",
          "type": "string",
          "default": "suggested",
          "enum": [
            "suggested",
            "streaming",
            "tv-us",
            "tv-gb",
            "tv-fi"
          ],
          "enumLabels": [
            "Starter picks",
            "Worldwide streaming",
            "United States TV",
            "United Kingdom TV",
            "Finland TV"
          ]
        }
      ]
    },
    {
      "id": "refresh-show",
      "name": "Refresh show",
      "settingsOnly": true,
      "parameters": [
        {
          "id": "show-id",
          "label": "TVmaze show ID",
          "type": "string",
          "required": true,
          "maxLength": 9
        }
      ]
    },
    {
      "id": "set-watched",
      "name": "Mark episode watched",
      "settingsOnly": true,
      "parameters": [
        {
          "id": "episode-id",
          "label": "Episode ID",
          "type": "string",
          "required": true,
          "maxLength": 9
        },
        {
          "id": "watched",
          "label": "Watched",
          "type": "boolean",
          "required": true
        }
      ]
    }
  ],
